# Anthropic API key — required for AI goal decomposition
ANTHROPIC_API_KEY=sk-ant-...

# GitHub Personal Access Token — recommended for github-skill-files scraper
# Without it: unauthenticated rate limit (10 search req/min); with it: 30/min
# Generate at https://github.com/settings/tokens — no scopes needed for public repos
# GITHUB_TOKEN=ghp_...

# SQLite DB path (optional — defaults to ../skills.db)
# DB_PATH=/custom/path/skills.db

# Server port (optional — defaults to 8000)
# PORT=8000
