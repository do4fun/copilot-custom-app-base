# Copie ce fichier en .env et remplis les valeurs

# Clé API Anthropic — obligatoire pour la décomposition de buts (Goals)
# et l'extraction intelligente de skills par les agents (Agent 1 - Scraper)
# Obtenir une clé : https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-api03-...

# Optionnel — clé GitHub pour augmenter les rate limits de l'API GitHub
# (60 req/h sans clé, 5000 req/h avec clé)
# Obtenir un token : https://github.com/settings/tokens (scope: public_repo)
GITHUB_TOKEN=ghp_...

# Optionnel — clé Brave Search pour le scraper MCP
# Obtenir une clé : https://brave.com/search/api/
BRAVE_API_KEY=BSA...
